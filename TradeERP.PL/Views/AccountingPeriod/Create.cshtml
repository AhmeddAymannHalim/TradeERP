@model AccountingPeriodViewModel
@{
    ViewBag.Title = L["InsertNewAccountingPeriod"];
}

<div class="row justify-content-center">
    <div class="col-xl-7">
        <form asp-action="Create">
            <div class="card">
                <div class="card-header bg-transparent px-4 py-3">
                    <h4 class="mb-0 h5">@L["InsertNewAccountingPeriod"]</h4>
                </div>
                <div class="card-body p-4">
                        <div class="row g-3 align-items-center justify-content-center">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">@L["Name"]</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="StartDate" class="form-label">@L["StartDate"]</label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="EndDate" class="form-label">@L["EndDate"]</label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                <div class="card-footer d-flex justify-content-center gap-2 bg-transparent">
                    <button type="submit" class="btn btn-primary px-5">@L["Save"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-5">@L["Cancel"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
