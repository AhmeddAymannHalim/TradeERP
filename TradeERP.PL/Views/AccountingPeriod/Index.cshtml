@model PaginatedResult<AccountingPeriodViewModel>
@{
    ViewBag.Title = L["AccountingPeriodList"];
}

<div class="row">
    <div class="col-12">
        <div class="d-flex gap-2 mb-3 flex-wrap justify-content-between align-items-center">
            <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
                <input type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" style="max-width: 250px;" />
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-search"></i>
                </button>
            </form>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> @L["New"]
            </a>
        </div>

        <div class="card table-responsive">
            <table class="table mb-0 text-nowrap table-hover">
                <thead class="table-light border-light">
                    <tr>
                        <th>#</th>
                        <th>@L["Name"]</th>
                        <th>@L["StartDate"]</th>
                        <th>@L["EndDate"]</th>
                        <th>@L["PostingStatus"]</th>
                        <th>@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data.Any())
                    {
                        var counter = (Model.PageNo - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Data)
                        {
                            <tr class="align-middle">
                                <td>@counter</td>
                                <td>@item.Name</td>
                                <td>@item.StartDate.ToShortDateString()</td>
                                <td>@item.EndDate.ToShortDateString()</td>
                                <td>
                                    @if (item.IsClosed)
                                    {
                                        <span class="badge bg-danger">@L["Closed"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@L["Open"]</span>
                                    }
                                </td>
                                <td>
                                    @if (!item.IsClosed)
                                    {
                                        <a href="javascript:void(0)" onclick="closePeriod(@item.Id)" class="btn btn-danger btn-sm">@L["ClosePeriod"]</a>
                                    }
                                </td>
                            </tr>
                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        function closePeriod(id) {
            fetch('/AccountingPeriod/Close/' + id)
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 800);
                    } else {
                        showToast(data.message, 'error');
                    }
                });
        }
    </script>
}
