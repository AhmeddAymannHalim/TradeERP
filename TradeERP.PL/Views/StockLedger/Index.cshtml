@using System.Globalization
@model PaginatedResult<StockLedgerViewModel>
@{
    ViewBag.Title = L["StockLedgerList"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="row">
    <div class="col-12">
        <div class="d-flex gap-2 mb-3 flex-wrap justify-content-end align-items-center">
            <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
                <input type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" style="max-width: 250px;" />
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>

        <div class="card table-responsive">
            <table class="table mb-0 text-nowrap table-hover">
                <thead class="table-light border-light">
                    <tr>
                        <th class="d-none d-lg-table-cell">#</th>
                        <th>@L["Product"]</th>
                        <th class="d-none d-md-table-cell">@L["MovementDate"]</th>
                        <th>@L["MovementType"]</th>
                        <th class="d-none d-md-table-cell">@L["Quantity"]</th>
                        <th class="d-none d-lg-table-cell">@L["UnitCost"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data.Any())
                    {
                        var counter = (Model.PageNo - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Data)
                        {
                            <tr class="align-middle">
                                <td class="d-none d-lg-table-cell">@counter</td>
                                <td>@(isArabicCulture ? item.ProductArName : item.ProductEnName)</td>
                                <td class="d-none d-md-table-cell">@item.MovementDate.ToShortDateString()</td>
                                <td>
                                    @if (item.MovementType == TradeERP.Shared.Enums.StockMovementType.In)
                                    {
                                        <span class="badge bg-success">@L["In"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@L["Out"]</span>
                                    }
                                </td>
                                <td class="d-none d-md-table-cell">@item.Quantity</td>
                                <td class="d-none d-lg-table-cell">@item.UnitCost</td>
                            </tr>
                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
