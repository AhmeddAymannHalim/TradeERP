@using System.Globalization
@model PaginatedResult<StockLedgerViewModel>
@{
    ViewBag.Title = L["StockLedgerList"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="fw-bold">@L["StockLedgerList"]</h4>
        </div>
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-end mb-3 flex-wrap gap-2">
                <form asp-action="Index" method="get" class="d-flex align-items-center gap-1">
                    <input type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L["Product"]</th>
                            <th>@L["MovementDate"]</th>
                            <th>@L["MovementType"]</th>
                            <th>@L["Quantity"]</th>
                            <th>@L["UnitCost"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data.Any())
                        {
                            var counter = (Model.PageNo - 1) * Model.PageSize + 1;
                            foreach (var item in Model.Data)
                            {
                                <tr>
                                    <td>@counter</td>
                                    <td>@(isArabicCulture ? item.ProductArName : item.ProductEnName)</td>
                                    <td>@item.MovementDate.ToShortDateString()</td>
                                    <td>
                                        @if (item.MovementType == TradeERP.Shared.Enums.StockMovementType.In)
                                        {
                                            <span class="badge bg-success">@L["In"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@L["Out"]</span>
                                        }
                                    </td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitCost</td>
                                </tr>
                                counter++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">@L["NoData"]</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @await Html.PartialAsync("_Pagination", Model)
            </div>
        </div>
    </div>
</div>
