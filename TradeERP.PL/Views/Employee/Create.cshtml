@using System.Globalization
@model EmployeeViewModel
@{
    ViewBag.Title = L["InsertNewEmployee"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <form asp-action="Create">
                <div class="card shadow-sm">
                    <div class="card-header text-center">
                        <h4 class="fw-bold m-0">@L["InsertNewEmployee"]</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 align-items-center justify-content-center">
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="Code" class="form-label">@L["Code"]</label>
                        <input asp-for="Code" class="form-control" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="ArName" class="form-label">@L["ArabicName"]</label>
                        <input asp-for="ArName" class="form-control" />
                        <span asp-validation-for="ArName" class="text-danger"></span>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="EnName" class="form-label">@L["EnglishName"]</label>
                        <input asp-for="EnName" class="form-control" />
                        <span asp-validation-for="EnName" class="text-danger"></span>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="PhoneNumber" class="form-label">@L["PhoneNumber"]</label>
                        <input asp-for="PhoneNumber" type="tel" class="form-control" data-phone-input />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="NationalId" class="form-label">@L["NationalId"]</label>
                        <input asp-for="NationalId" class="form-control" />
                        <span asp-validation-for="NationalId" class="text-danger"></span>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="Email" class="form-label">@L["Email"]</label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="HireDate" class="form-label">@L["HireDate"]</label>
                        <input asp-for="HireDate" type="date" class="form-control" />
                        <span asp-validation-for="HireDate" class="text-danger"></span>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="BirthDate" class="form-label">@L["BirthDate"]</label>
                        <input asp-for="BirthDate" type="date" class="form-control" />
                        <span asp-validation-for="BirthDate" class="text-danger"></span>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="SpecializationId" class="form-label">@L["Specialization"]</label>
                        <select asp-for="SpecializationId" class="form-select">
                            <option value="">@L["Choose"]</option>
                            @foreach (var item in Model.Specializations)
                            {
                                <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="DepartmentId" class="form-label">@L["Department"]</label>
                        <select asp-for="DepartmentId" class="form-select">
                            <option value="">@L["Choose"]</option>
                            @foreach (var item in Model.Departments)
                            {
                                <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="ManagerId" class="form-label">@L["Manager"]</label>
                        <select asp-for="ManagerId" class="form-select">
                            <option value="">@L["Choose"]</option>
                            @foreach (var item in Model.Managers)
                            {
                                <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="JobTitle" class="form-label">@L["JobTitle"]</label>
                        <input asp-for="JobTitle" class="form-control" />
                        <span asp-validation-for="JobTitle" class="text-danger"></span>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="Gender" class="form-label">@L["Gender"]</label>
                        <select asp-for="Gender" class="form-select">
                            @foreach (var item in Html.GetEnumSelectList<TradeERP.Shared.Enums.Gender>())
                            {
                                <option value="@item.Value">@L[item.Text]</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="MaritalStatus" class="form-label">@L["MaritalStatus"]</label>
                        <select asp-for="MaritalStatus" class="form-select">
                            @foreach (var item in Html.GetEnumSelectList<TradeERP.Shared.Enums.MaritalStatus>())
                            {
                                <option value="@item.Value">@L[item.Text]</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="ContractType" class="form-label">@L["ContractType"]</label>
                        <select asp-for="ContractType" class="form-select">
                            @foreach (var item in Html.GetEnumSelectList<TradeERP.Shared.Enums.ContractType>())
                            {
                                <option value="@item.Value">@L[item.Text]</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="BasicSalary" class="form-label">@L["BasicSalary"]</label>
                        <input asp-for="BasicSalary" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="BasicSalary" class="text-danger"></span>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="BankAccountNumber" class="form-label">@L["BankAccountNumber"]</label>
                        <input asp-for="BankAccountNumber" class="form-control" />
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="IBAN" class="form-label">@L["IBAN"]</label>
                        <input asp-for="IBAN" class="form-control" />
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="InsuranceNumber" class="form-label">@L["InsuranceNumber"]</label>
                        <input asp-for="InsuranceNumber" class="form-control" />
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <label asp-for="NationalityId" class="form-label">@L["Nationality"]</label>
                        <select asp-for="NationalityId" class="form-select">
                            <option value="">@L["Choose"]</option>
                            @foreach (var item in Model.Nationalities)
                            {
                                <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label asp-for="CountryId" class="form-label">@L["Country"]</label>
                        <select asp-for="CountryId" id="countrySelect" class="form-select">
                            <option value="">@L["SelectCountry"]</option>
                            @foreach (var item in Model.Countries)
                            {
                                <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label asp-for="GovId" class="form-label">@L["Gov"]</label>
                        <select asp-for="GovId" id="govSelect" class="form-select" data-placeholder="@L["SelectGov"]">
                            <option value="">@L["SelectGov"]</option>
                            @foreach (var item in Model.Govs)
                            {
                                <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label asp-for="TownId" class="form-label">@L["Town"]</label>
                        <select asp-for="TownId" id="townSelect" class="form-select" data-placeholder="@L["SelectTown"]">
                            <option value="">@L["SelectTown"]</option>
                            @foreach (var item in Model.Towns)
                            {
                                <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label asp-for="VillageId" class="form-label">@L["Village"]</label>
                        <select asp-for="VillageId" id="villageSelect" class="form-select" data-placeholder="@L["SelectVillage"]">
                            <option value="">@L["SelectVillage"]</option>
                            @foreach (var item in Model.Villages)
                            {
                                <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-8 col-md-12">
                        <label asp-for="Address" class="form-label">@L["Address"]</label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                    <div class="col-lg-4 col-md-6 d-flex align-items-center">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">@L["IsActive"]</label>
                        </div>
                    </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-primary px-5">@L["Save"]</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-5">@L["Cancel"]</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
