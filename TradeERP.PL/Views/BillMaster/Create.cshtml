@using System.Globalization
@model BillMasterViewModel
@{
    ViewBag.Title = L["InsertNewBillMaster"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-xl-9">
            <form asp-action="Create">
                <div class="card shadow-sm">
                    <div class="card-header text-center">
                        <h4 class="fw-bold m-0">@L["InsertNewBillMaster"]</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 align-items-center justify-content-center">
                            <div class="col-md-4">
                                <label asp-for="Code" class="form-label"></label>
                                <input asp-for="Code" class="form-control" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BillDate" class="form-label">@L["BillDate"]</label>
                                <input asp-for="BillDate" type="date" class="form-control" />
                                <span asp-validation-for="BillDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BillType" class="form-label">@L["BillType"]</label>
                                <select asp-for="BillType" class="form-select">
                                    @foreach (var item in Html.GetEnumSelectList<TradeERP.Shared.Enums.BillType>())
                                    {
                                        <option value="@item.Value">@L[item.Text]</option>
                                    }
                                </select>
                                <span asp-validation-for="BillType" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CustomerId" class="form-label">@L["Customer"]</label>
                                <select asp-for="CustomerId" class="form-select">
                                    <option value="">@L["Choose"]</option>
                                    @foreach (var item in Model.Customers)
                                    {
                                        <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SupplierId" class="form-label">@L["Supplier"]</label>
                                <select asp-for="SupplierId" class="form-select">
                                    <option value="">@L["Choose"]</option>
                                    @foreach (var item in Model.Suppliers)
                                    {
                                        <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="alert alert-info mt-3 mb-0">
                            @L["AmountComputedNote"]
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-primary px-5">@L["Save"]</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-5">@L["Cancel"]</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
