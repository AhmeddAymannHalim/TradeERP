@model EntrySettingViewModel
@{
    ViewBag.Title = L["InsertNewEntrySetting"];
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <form asp-action="Create">
            <div class="card">
                <div class="card-header bg-transparent px-4 py-3">
                    <h4 class="mb-0 h5">@L["InsertNewEntrySetting"]</h4>
                </div>
                <div class="card-body p-4">
                        <div class="row g-3 align-items-center justify-content-center">
                            <div class="col-md-4">
                                <label asp-for="Code" class="form-label"></label>
                                <input asp-for="Code" class="form-control" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Prefix" class="form-label">@L["Prefix"]</label>
                                <input asp-for="Prefix" class="form-control" />
                                <span asp-validation-for="Prefix" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="NextNumber" class="form-label">@L["NextNumber"]</label>
                                <input asp-for="NextNumber" class="form-control" />
                                <span asp-validation-for="NextNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                <div class="card-footer d-flex justify-content-center gap-2 bg-transparent">
                    <button type="submit" class="btn btn-primary px-5">@L["Save"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-5">@L["Cancel"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
