@model CustomerViewModel
@{
    ViewBag.Title = L["EditCustomer"];
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-xl-9">
            <form asp-action="Update">
                <input type="hidden" asp-for="Id" />
                <div class="card shadow-sm">
                    <div class="card-header text-center">
                        <h4 class="fw-bold m-0">@L["EditCustomer"]</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 align-items-center justify-content-center">
                            <div class="col-md-4">
                                <label asp-for="Code" class="form-label"></label>
                                <input asp-for="Code" class="form-control" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ArName" class="form-label">@L["ArabicName"]</label>
                                <input asp-for="ArName" class="form-control" />
                                <span asp-validation-for="ArName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="EnName" class="form-label">@L["EnglishName"]</label>
                                <input asp-for="EnName" class="form-control" />
                                <span asp-validation-for="EnName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">@L["PhoneNumber"]</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label">@L["Address"]</label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-primary px-5">@L["Save"]</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-5">@L["Cancel"]</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
