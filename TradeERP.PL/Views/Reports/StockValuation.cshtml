@using System.Globalization
@model List<StockValuationRowViewModel>
@{
    ViewBag.Title = L["StockValuation"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    var grandTotal = Model.Sum(r => r.TotalValue);
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="fw-bold">@L["StockValuation"]</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>@L["Product"]</th>
                            <th>@L["Quantity"]</th>
                            <th>@L["UnitCost"]</th>
                            <th>@L["Amount"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var row in Model)
                            {
                                <tr>
                                    <td>@(isArabicCulture ? row.ProductArName : row.ProductEnName)</td>
                                    <td>@row.Quantity.ToString("N3")</td>
                                    <td>@row.AverageCost.ToString("N2")</td>
                                    <td>@row.TotalValue.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4">@L["NoData"]</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="3">@L["Amount"]</td>
                            <td>@grandTotal.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
