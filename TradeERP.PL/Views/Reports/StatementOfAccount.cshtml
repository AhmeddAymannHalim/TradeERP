@using System.Globalization
@using TradeERP.Shared.ViewModels.Commons
@model List<StatementOfAccountRowViewModel>
@{
    ViewBag.Title = L["StatementOfAccount"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    var ledgerAccounts = (List<LookupItem>)ViewBag.LedgerAccounts;
    var selectedId = ViewBag.LedgerAccountId as int?;
}

<div class="row">
    <div class="col-12">
        <div class="card mb-3">
            <div class="card-body p-4">
                <form asp-action="StatementOfAccount" method="get" class="row g-2">
                    <div class="col-md-4">
                        <select name="ledgerAccountId" class="form-select">
                            <option value="">@L["Choose"]</option>
                            @foreach (var item in ledgerAccounts)
                            {
                                <option value="@item.Id" selected="@(item.Id == selectedId)">@(isArabicCulture ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate as DateTime? )" />
                    </div>
                    <div class="col-md-3">
                        <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate as DateTime? )" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary">@L["SearchHere"]</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card table-responsive">
            <table class="table mb-0 text-nowrap table-hover">
                <thead class="table-light border-light">
                    <tr>
                        <th>@L["EntryDate"]</th>
                        <th>@L["Description"]</th>
                        <th>@L["DebitAmount"]</th>
                        <th>@L["CreditAmount"]</th>
                        <th>@L["RunningBalance"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var row in Model)
                        {
                            <tr class="align-middle">
                                <td>@row.EntryDate.ToShortDateString()</td>
                                <td>@row.Description</td>
                                <td>@row.DebitAmount.ToString("N2")</td>
                                <td>@row.CreditAmount.ToString("N2")</td>
                                <td>@row.RunningBalance.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
