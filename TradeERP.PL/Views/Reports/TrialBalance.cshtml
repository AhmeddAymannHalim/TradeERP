@using System.Globalization
@model List<TrialBalanceRowViewModel>
@{
    ViewBag.Title = L["TrialBalance"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    var totalDebit = Model.Sum(r => r.TotalDebit);
    var totalCredit = Model.Sum(r => r.TotalCredit);
}

<div class="row">
    <div class="col-12">
        <div class="card mb-3">
            <div class="card-body p-4">
                <form asp-action="TrialBalance" method="get" class="row g-2">
                    <div class="col-md-3">
                        <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate as DateTime? )" />
                    </div>
                    <div class="col-md-3">
                        <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate as DateTime? )" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary">@L["SearchHere"]</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card table-responsive">
            <table class="table mb-0 text-nowrap table-hover">
                <thead class="table-light border-light">
                    <tr>
                        <th>@L["Account"]</th>
                        <th>@L["DebitAmount"]</th>
                        <th>@L["CreditAmount"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var row in Model)
                        {
                            <tr class="align-middle">
                                <td>@(isArabicCulture ? row.LedgerAccountArName : row.LedgerAccountEnName)</td>
                                <td>@row.TotalDebit.ToString("N2")</td>
                                <td>@row.TotalCredit.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td>@L["Amount"]</td>
                        <td>@totalDebit.ToString("N2")</td>
                        <td>@totalCredit.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (Model.Any())
        {
            if (totalDebit == totalCredit)
            {
                <div class="alert alert-success mt-3 mb-0">@L["TrialBalanceBalanced"]</div>
            }
            else
            {
                <div class="alert alert-danger mt-3 mb-0">@L["TrialBalanceNotBalanced"]</div>
            }
        }
    </div>
</div>
