@using System.Globalization
@model List<TrialBalanceRowViewModel>
@{
    ViewBag.Title = L["TrialBalance"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    var totalDebit = Model.Sum(r => r.TotalDebit);
    var totalCredit = Model.Sum(r => r.TotalCredit);
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="fw-bold">@L["TrialBalance"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="TrialBalance" method="get" class="row g-2 mb-3">
                <div class="col-md-3">
                    <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate as DateTime? )" />
                </div>
                <div class="col-md-3">
                    <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate as DateTime? )" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary">@L["SearchHere"]</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>@L["Account"]</th>
                            <th>@L["DebitAmount"]</th>
                            <th>@L["CreditAmount"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var row in Model)
                            {
                                <tr>
                                    <td>@(isArabicCulture ? row.LedgerAccountArName : row.LedgerAccountEnName)</td>
                                    <td>@row.TotalDebit.ToString("N2")</td>
                                    <td>@row.TotalCredit.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3">@L["NoData"]</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td>@L["Amount"]</td>
                            <td>@totalDebit.ToString("N2")</td>
                            <td>@totalCredit.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (Model.Any())
            {
                if (totalDebit == totalCredit)
                {
                    <div class="alert alert-success mb-0">@L["TrialBalanceBalanced"]</div>
                }
                else
                {
                    <div class="alert alert-danger mb-0">@L["TrialBalanceNotBalanced"]</div>
                }
            }
        </div>
    </div>
</div>
