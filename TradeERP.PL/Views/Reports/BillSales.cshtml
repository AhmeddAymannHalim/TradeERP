@using System.Globalization
@model List<BillMasterViewModel>
@{
    ViewBag.Title = L["BillSales"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="row">
    <div class="col-12">
        <div class="card table-responsive">
            <table class="table mb-0 text-nowrap table-hover">
                <thead class="table-light border-light">
                    <tr>
                        <th>@L["Customer"]</th>
                        <th>@L["Amount"]</th>
                        <th class="d-none d-md-table-cell">@L["MovementDate"]</th>
                        <th class="d-none d-lg-table-cell">@L["BillType"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var row in Model)
                        {
                            <tr class="align-middle">
                                <td>@(isArabicCulture ? @row.CustomerArName : @row.CustomerEnName) </td>
                                <td>@row.Amount</td>
                                <td class="d-none d-md-table-cell">@row.BillDate</td>
                                <td class="d-none d-lg-table-cell">@L[row.BillType.ToString()]</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
