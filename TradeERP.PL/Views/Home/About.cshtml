@{
    ViewData["Title"] = "About";
}

<div class="row mb-5">
    <div class="col-lg-8">
        <h1>About TradeERP</h1>
        <p class="lead">A Clean Architecture ERP system for Trading &amp; Distribution companies.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <h3>Our Mission</h3>
        <p>
            To provide a maintainable, well-layered foundation for building trading and distribution
            operations tooling — from master data to inventory, sales, HR, and accounting.
        </p>
    </div>
    <div class="col-md-6 mb-4">
        <h3>Architecture</h3>
        <ul>
            <li>Clean Architecture (Shared / DAL / BLL / PL)</li>
            <li>Entity Framework Core</li>
            <li>Explicit, non-generic repositories</li>
            <li>Responsive Bootstrap 5 UI</li>
        </ul>
    </div>
</div>

<hr class="my-5">

<div class="row">
    <div class="col-md-12">
        <h3 class="mb-4">Key Technologies</h3>
        <div class="row">
            <div class="col-md-3 mb-3">
                <div class="badge bg-primary p-3">
                    <h6 class="mb-0">ASP.NET Core 8</h6>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="badge bg-success p-3">
                    <h6 class="mb-0">EF Core</h6>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="badge bg-info p-3">
                    <h6 class="mb-0">Bootstrap 5</h6>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="badge bg-warning p-3">
                    <h6 class="mb-0">AutoMapper</h6>
                </div>
            </div>
        </div>
    </div>
</div>
