@using System.Globalization
@model TradeERP.Shared.ViewModels.Definitions.Reports.DashboardSummaryViewModel
@{
    ViewData["Title"] = L["Dashboard"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
}

<div class="row g-3 mb-3">
    <div class="col-lg-3 col-12">
        <div class="card p-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-2">
            <div class="d-flex gap-3">
                <div class="icon-shape icon-md bg-primary text-white rounded-2">
                    <i class="ti ti-package fs-4"></i>
                </div>
                <div>
                    <h2 class="mb-3 fs-6">@L["TotalProducts"]</h2>
                    <h3 class="fw-bold mb-0">@Model.TotalProducts</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-12">
        <div class="card p-4 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-2">
            <div class="d-flex gap-3">
                <div class="icon-shape icon-md bg-success text-white rounded-2">
                    <i class="ti ti-user-heart fs-4"></i>
                </div>
                <div>
                    <h2 class="mb-3 fs-6">@L["TotalCustomers"]</h2>
                    <h3 class="fw-bold mb-0">@Model.TotalCustomers</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-12">
        <div class="card p-4 bg-info bg-opacity-10 border border-info border-opacity-25 rounded-2">
            <div class="d-flex gap-3">
                <div class="icon-shape icon-md bg-info text-white rounded-2">
                    <i class="ti ti-truck-delivery fs-4"></i>
                </div>
                <div>
                    <h2 class="mb-3 fs-6">@L["TotalSuppliers"]</h2>
                    <h3 class="fw-bold mb-0">@Model.TotalSuppliers</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-12">
        <div class="card p-4 bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-2">
            <div class="d-flex gap-3">
                <div class="icon-shape icon-md bg-warning text-white rounded-2">
                    <i class="ti ti-users fs-4"></i>
                </div>
                <div>
                    <h2 class="mb-3 fs-6">@L["TotalEmployees"]</h2>
                    <h3 class="fw-bold mb-0">@Model.TotalEmployees</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-4 col-12">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between border-bottom pb-5 mb-3">
                    <div>
                        <h3 class="fw-bold h4">@Model.TodaySalesAmount.ToString("N2")</h3>
                        <span>@L["TodaySales"]</span>
                    </div>
                    <div>
                        <i class="ti ti-receipt fs-1 text-primary"></i>
                    </div>
                </div>
                <div class="small text-muted">
                    <a asp-controller="Reports" asp-action="BillSales" class="link-primary text-decoration-underline">@L["BillSales"]</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-12">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between border-bottom pb-5 mb-3">
                    <div>
                        <h3 class="fw-bold h4">@Model.MonthSalesAmount.ToString("N2")</h3>
                        <span>@L["MonthSales"]</span>
                    </div>
                    <div>
                        <i class="ti ti-shopping-cart fs-1 text-success"></i>
                    </div>
                </div>
                <div class="small text-muted">
                    <a asp-controller="BillMaster" asp-action="Index" class="link-primary text-decoration-underline">@L["BillMasterList"]</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-12">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between border-bottom pb-5 mb-3">
                    <div>
                        <h3 class="fw-bold h4">@Model.MonthPurchasesAmount.ToString("N2")</h3>
                        <span>@L["MonthPurchases"]</span>
                    </div>
                    <div>
                        <i class="ti ti-truck fs-1 text-warning"></i>
                    </div>
                </div>
                <div class="small text-muted">
                    <a asp-controller="Reports" asp-action="BillPurchases" class="link-primary text-decoration-underline">@L["BillPurchases"]</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center px-4 py-3">
                <h4 class="mb-0 h5">@L["TopStockValueProducts"]</h4>
                <span class="badge bg-primary-subtle text-primary">@Model.TotalStockValue.ToString("N2")</span>
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.TopStockValueProducts.Any())
                {
                    foreach (var item in Model.TopStockValueProducts)
                    {
                        <li class="list-group-item d-flex align-items-center justify-content-between gap-3">
                            <div class="flex-grow-1">
                                <p class="mb-1">@(isArabicCulture ? item.ProductArName : item.ProductEnName)</p>
                                <small class="text-muted">@item.Quantity.ToString("N0")</small>
                            </div>
                            <span class="fw-semibold text-primary">@item.TotalValue.ToString("N2")</span>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted">@L["NoStockData"]</li>
                }
            </ul>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center px-4 py-3">
                <h4 class="mb-0 h5">@L["RecentSales"]</h4>
                <a asp-controller="Reports" asp-action="BillSales" class="small text-primary text-decoration-underline">@L["Reports"]</a>
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.RecentSales.Any())
                {
                    foreach (var item in Model.RecentSales)
                    {
                        <li class="list-group-item d-flex align-items-center justify-content-between gap-3">
                            <div class="flex-grow-1">
                                <p class="mb-1">@item.Code</p>
                                <small class="text-muted">@(isArabicCulture ? item.CustomerArName : item.CustomerEnName) · @item.BillDate.ToString("yyyy-MM-dd")</small>
                            </div>
                            <span class="fw-semibold text-success">@item.Amount.ToString("N2")</span>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted">@L["NoRecentSales"]</li>
                }
            </ul>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center px-4 py-3">
                <h4 class="mb-0 h5">@L["RecentPurchases"]</h4>
                <a asp-controller="Reports" asp-action="BillPurchases" class="small text-primary text-decoration-underline">@L["Reports"]</a>
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.RecentPurchases.Any())
                {
                    foreach (var item in Model.RecentPurchases)
                    {
                        <li class="list-group-item d-flex align-items-center justify-content-between gap-3">
                            <div class="flex-grow-1">
                                <p class="mb-1">@item.Code</p>
                                <small class="text-muted">@(isArabicCulture ? item.SupplierArName : item.SupplierEnName) · @item.BillDate.ToString("yyyy-MM-dd")</small>
                            </div>
                            <span class="fw-semibold text-warning">@item.Amount.ToString("N2")</span>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted">@L["NoRecentPurchases"]</li>
                }
            </ul>
        </div>
    </div>
</div>
