@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-4">Dashboard</h1>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Definitions</h5>
                <p class="card-text text-muted">Employees, Departments, and other master data.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Inventory</h5>
                <p class="card-text text-muted">Products and stock management.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Sales</h5>
                <p class="card-text text-muted">Orders and customer transactions.</p>
            </div>
        </div>
    </div>
</div>
