            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-bar-chart-line text-info me-1"></i> Reports
            </div>
            <div class="card-body">
                <p class="text-muted">Operational and management reports built on top of the Definitions data. Not implemented yet.</p>
            </div>
        </div>
    </div>
</div>
