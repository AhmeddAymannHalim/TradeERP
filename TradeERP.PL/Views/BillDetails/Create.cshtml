@using System.Globalization
@model BillDetailsViewModel
@{
    ViewBag.Title = L["InsertNewBillDetails"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <form asp-action="Create">
            <div class="card">
                <div class="card-header bg-transparent px-4 py-3">
                    <h4 class="mb-0 h5">@L["InsertNewBillDetails"]</h4>
                </div>
                <div class="card-body p-4">
                        <div class="row g-3 align-items-center justify-content-center">
                            <div class="col-md-4">
                                <label asp-for="Code" class="form-label"></label>
                                <input asp-for="Code" class="form-control" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BillMasterId" class="form-label">@L["Bill"]</label>
                                <select asp-for="BillMasterId" class="form-select">
                                    <option value="">@L["Choose"]</option>
                                    @foreach (var item in Model.BillMasters)
                                    {
                                        <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                                    }
                                </select>
                                <span asp-validation-for="BillMasterId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ProductId" class="form-label">@L["Product"]</label>
                                <select asp-for="ProductId" class="form-select">
                                    <option value="">@L["Choose"]</option>
                                    @foreach (var item in Model.Products)
                                    {
                                        <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                                    }
                                </select>
                                <span asp-validation-for="ProductId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Quantity" class="form-label">@L["Quantity"]</label>
                                <input asp-for="Quantity" id="Quantity" class="form-control" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="UnitPrice" class="form-label">@L["UnitPrice"]</label>
                                <input asp-for="UnitPrice" id="UnitPrice" class="form-control" />
                                <span asp-validation-for="UnitPrice" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="LineTotal" class="form-label">@L["LineTotal"]</label>
                                <input asp-for="LineTotal" id="LineTotal" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                <div class="card-footer d-flex justify-content-center gap-2 bg-transparent">
                    <button type="submit" class="btn btn-primary px-5">@L["Save"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-5">@L["Cancel"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function calculateLineTotal() {
            var qty = parseFloat(document.getElementById('Quantity').value) || 0;
            var price = parseFloat(document.getElementById('UnitPrice').value) || 0;
            document.getElementById('LineTotal').value = (qty * price).toFixed(2);
        }
        document.getElementById('Quantity').addEventListener('input', calculateLineTotal);
        document.getElementById('UnitPrice').addEventListener('input', calculateLineTotal);
        calculateLineTotal();
    </script>
}
