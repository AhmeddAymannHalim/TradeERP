@using System.Globalization
@model PaginatedResult<BillDetailsViewModel>
@{
    ViewBag.Title = L["BillDetailsList"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="fw-bold">@L["BillDetailsList"]</h4>
        </div>
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> @L["New"]
                </a>
                <form asp-action="Index" method="get" class="d-flex align-items-center gap-1">
                    <input type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L["Code"]</th>
                            <th>@L["Bill"]</th>
                            <th>@L["Product"]</th>
                            <th>@L["Quantity"]</th>
                            <th>@L["Price"]</th>
                            <th>@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data.Any())
                        {
                            var counter = (Model.PageNo - 1) * Model.PageSize + 1;
                            foreach (var item in Model.Data)
                            {
                                <tr>
                                    <td>@counter</td>
                                    <td>@item.Code</td>
                                    <td>@item.BillMasterCode</td>
                                    <td>@(isArabicCulture ? item.ProductArName : item.ProductEnName)</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice</td>
                                    <td>
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="javascript:void(0)" onclick="Delete('/BillDetails/Delete/@item.Id')" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                counter++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7">@L["NoData"]</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @await Html.PartialAsync("_Pagination", Model)
            </div>
        </div>
    </div>
</div>
