@model PaginatedResult<VoucherMasterViewModel>
@{
    ViewBag.Title = L["VoucherMasterList"];
}

<div class="row">
    <div class="col-12">
        <div class="d-flex gap-2 mb-3 flex-wrap justify-content-between align-items-center">
            <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
                <input type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" style="max-width: 250px;" />
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-search"></i>
                </button>
            </form>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> @L["New"]
            </a>
        </div>

        <div class="card table-responsive">
            <table class="table mb-0 text-nowrap table-hover">
                <thead class="table-light border-light">
                    <tr>
                        <th class="d-none d-lg-table-cell">#</th>
                        <th>@L["Code"]</th>
                        <th class="d-none d-md-table-cell">@L["VoucherDate"]</th>
                        <th class="d-none d-lg-table-cell">@L["VoucherType"]</th>
                        <th class="d-none d-md-table-cell">@L["Amount"]</th>
                        <th>@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data.Any())
                    {
                        var counter = (Model.PageNo - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Data)
                        {
                            <tr class="align-middle">
                                <td class="d-none d-lg-table-cell">@counter</td>
                                <td>@item.Code</td>
                                <td class="d-none d-md-table-cell">@item.VoucherDate.ToShortDateString()</td>
                                <td class="d-none d-lg-table-cell">@L[item.VoucherType.ToString()]</td>
                                <td class="d-none d-md-table-cell">@item.Amount</td>
                                <td>
                                    <a href="javascript:void(0)" onclick="Delete('/VoucherMaster/Delete/@item.Id')" class="link-danger"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
