@using System.Globalization
@using Microsoft.AspNetCore.Localization
@model LoginViewModel
@{
    Layout = null;
    bool isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    string dir = isArabic ? "rtl" : "ltr";
    string lang = isArabic ? "ar" : "en";
    string returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/Account/Login" : $"~{Context.Request.Path.Value}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Login"] - TradeERP</title>
    <link rel="stylesheet" href="~/template/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/template/css/nav-extras.css" asp-append-version="true" />
    @if (isArabic)
    {
        <link rel="stylesheet" href="~/template/css/rtl.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: #fafafa;
        }

        .language-switch {
            position: absolute;
            top: 1rem;
            @(isArabic ? "left" : "right"): 1rem;
        }
    </style>
</head>
<body>
    <div class="dropdown language-switch">
        <a class="btn btn-outline-secondary btn-sm dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            <i class="ti ti-world me-1"></i>@(isArabic ? L["Arabic"] : L["English"])
        </a>
        <ul class="dropdown-menu @(isArabic ? "" : "dropdown-menu-end")">
            <li>
                <a class="dropdown-item @(isArabic ? "active" : "")" asp-action="SetLanguage" asp-controller="Home"
                   asp-route-culture="ar" asp-route-returnUrl="@returnUrl">
                    @L["Arabic"]
                </a>
            </li>
            <li>
                <a class="dropdown-item @(!isArabic ? "active" : "")" asp-action="SetLanguage" asp-controller="Home"
                   asp-route-culture="en" asp-route-returnUrl="@returnUrl">
                    @L["English"]
                </a>
            </li>
        </ul>
    </div>

    <div class="container d-flex align-items-center justify-content-center min-vh-100">
        <div class="card" style="max-width:420px; width:100%;">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="ti ti-building-store fs-1 text-primary d-block mb-2"></i>
                    <h1 class="h5 mb-0">TradeERP</h1>
                </div>
                <form asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">@L["Email"]</label>
                        <input asp-for="Email" class="form-control" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label d-flex justify-content-between">
                            <span>@L["Password"]</span>
                            <a asp-action="ForgotPassword" class="small link-primary">@L["ForgotPassword"]</a>
                        </label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small">@L["RememberMe"]</label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@L["SignIn"]</button>
                </form>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/template/js/main.js" type="module"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <partial name="_LocalizationScript" />
    <script src="~/js/site.js" asp-append-version="true"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
</body>
</html>
