@using System.Globalization
@using Microsoft.AspNetCore.Localization
@model LoginViewModel
@{
    Layout = null;
    bool isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    string dir = isArabic ? "rtl" : "ltr";
    string lang = isArabic ? "ar" : "en";
    string bootstrapCss = isArabic
        ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
        : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css";
    string returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/Account/Login" : $"~{Context.Request.Path.Value}{Context.Request.QueryString}";
    var externalProviders = (HashSet<string?>?)ViewBag.ExternalProviders ?? new HashSet<string?>();
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Login"] - TradeERP</title>
    <link href="@bootstrapCss" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f4f6f9;
        }

        .language-switch {
            position: absolute;
            top: 1rem;
            @(isArabic ? "left" : "right"): 1rem;
        }

        .social-login-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
        }
    </style>
</head>
<body>
    <div class="dropdown language-switch">
        <a class="btn btn-outline-secondary btn-sm dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            <i class="bi bi-globe2 me-1"></i>@(isArabic ? L["Arabic"] : L["English"])
        </a>
        <ul class="dropdown-menu @(isArabic ? "" : "dropdown-menu-end")">
            <li>
                <a class="dropdown-item @(isArabic ? "active" : "")" asp-action="SetLanguage" asp-controller="Home"
                   asp-route-culture="ar" asp-route-returnUrl="@returnUrl">
                    @L["Arabic"]
                </a>
            </li>
            <li>
                <a class="dropdown-item @(!isArabic ? "active" : "")" asp-action="SetLanguage" asp-controller="Home"
                   asp-route-culture="en" asp-route-returnUrl="@returnUrl">
                    @L["English"]
                </a>
            </li>
        </ul>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h4 class="fw-bold text-center mb-4">TradeERP</h4>
                        <form asp-action="Login" method="post">
                            <input type="hidden" asp-for="ReturnUrl" />
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">@L["Email"]</label>
                                <input asp-for="Email" class="form-control" autofocus />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">@L["Password"]</label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="form-check">
                                    <input asp-for="RememberMe" class="form-check-input" />
                                    <label asp-for="RememberMe" class="form-check-label">@L["RememberMe"]</label>
                                </div>
                                <a asp-action="ForgotPassword" class="small">@L["ForgotPassword"]</a>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">@L["SignIn"]</button>
                        </form>

                        @if (externalProviders.Count > 0)
                        {
                            <div class="d-flex align-items-center my-3">
                                <hr class="flex-grow-1" />
                                <span class="mx-2 text-muted small">@L["OrContinueWith"]</span>
                                <hr class="flex-grow-1" />
                            </div>

                            <div class="d-grid gap-2">
                                @if (externalProviders.Contains("Google"))
                                {
                                    <a class="btn btn-outline-dark social-login-btn"
                                       asp-action="ExternalLogin" asp-route-provider="Google" asp-route-returnUrl="@Model.ReturnUrl">
                                        <i class="bi bi-google"></i> @L["ContinueWithGoogle"]
                                    </a>
                                }
                                @if (externalProviders.Contains("Facebook"))
                                {
                                    <a class="btn btn-outline-dark social-login-btn"
                                       asp-action="ExternalLogin" asp-route-provider="Facebook" asp-route-returnUrl="@Model.ReturnUrl">
                                        <i class="bi bi-facebook"></i> @L["ContinueWithFacebook"]
                                    </a>
                                }
                                @if (externalProviders.Contains("Apple"))
                                {
                                    <a class="btn btn-outline-dark social-login-btn"
                                       asp-action="ExternalLogin" asp-route-provider="Apple" asp-route-returnUrl="@Model.ReturnUrl">
                                        <i class="bi bi-apple"></i> @L["ContinueWithApple"]
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <partial name="_LocalizationScript" />
    <script src="~/js/site.js" asp-append-version="true"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
</body>
</html>
