@model AccountSettingsViewModel
@{
    ViewBag.Title = L["AccountSettings"];
}

<div class="row justify-content-center">
    <div class="col-xl-7">
        <div class="card mb-4">
            <div class="card-header bg-transparent px-4 py-3">
                <h4 class="mb-0 h5">@L["AccountInfo"]</h4>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 justify-content-center">
                    <div class="col-md-6">
                        <label class="form-label">@L["Email"]</label>
                        <input class="form-control" value="@Model.Email" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@L["Admin"]</label>
                        <input class="form-control" value="@Model.UserName" disabled />
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="ChangePassword">
            <div class="card">
                <div class="card-header bg-transparent px-4 py-3">
                    <h4 class="mb-0 h5">@L["ChangePassword"]</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3 justify-content-center">
                        <div class="col-md-8">
                            <label class="form-label">@L["CurrentPassword"]</label>
                            <input type="password" name="CurrentPassword" class="form-control" />
                            <span data-valmsg-for="CurrentPassword" class="text-danger"></span>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">@L["NewPassword"]</label>
                            <input type="password" name="NewPassword" class="form-control" />
                            <span data-valmsg-for="NewPassword" class="text-danger"></span>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">@L["ConfirmPassword"]</label>
                            <input type="password" name="ConfirmPassword" class="form-control" />
                            <span data-valmsg-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-center bg-transparent">
                    <button type="submit" class="btn btn-primary px-5">@L["Save"]</button>
                </div>
            </div>
        </form>
    </div>
</div>
