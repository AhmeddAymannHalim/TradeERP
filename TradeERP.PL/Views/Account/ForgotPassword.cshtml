@using System.Globalization
@model ForgotPasswordViewModel
@{
    Layout = null;
    bool isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    string dir = isArabic ? "rtl" : "ltr";
    string lang = isArabic ? "ar" : "en";
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["ForgotPassword"] - TradeERP</title>
    <link rel="stylesheet" href="~/template/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/template/css/nav-extras.css" asp-append-version="true" />
    @if (isArabic)
    {
        <link rel="stylesheet" href="~/template/css/rtl.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: #fafafa;
        }
    </style>
</head>
<body>
    <div class="container d-flex align-items-center justify-content-center min-vh-100">
        <div class="card" style="max-width:420px; width:100%;">
            <div class="card-body p-5">
                <h1 class="h5 text-center mb-4">@L["ForgotPassword"]</h1>
                <form asp-action="ForgotPassword" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">@L["Email"]</label>
                        <input asp-for="Email" class="form-control" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@L["SendResetLink"]</button>
                    <a asp-action="Login" class="btn btn-link w-100 mt-2">@L["BackToLogin"]</a>
                </form>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/template/js/main.js" type="module"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <partial name="_LocalizationScript" />
    <script src="~/js/site.js" asp-append-version="true"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
</body>
</html>
