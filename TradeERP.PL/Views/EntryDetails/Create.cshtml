@using System.Globalization
@model EntryDetailsViewModel
@{
    ViewBag.Title = L["InsertNewEntryDetails"];
    bool isArabicCulture = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <form asp-action="Create">
            <div class="card">
                <div class="card-header bg-transparent px-4 py-3">
                    <h4 class="mb-0 h5">@L["InsertNewEntryDetails"]</h4>
                </div>
                <div class="card-body p-4">
                        <div class="row g-3 align-items-center justify-content-center">
                            <div class="col-md-4">
                                <label asp-for="Code" class="form-label"></label>
                                <input asp-for="Code" class="form-control" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="EntryMasterId" class="form-label">@L["JournalEntry"]</label>
                                <select asp-for="EntryMasterId" class="form-select">
                                    <option value="">@L["Choose"]</option>
                                    @foreach (var item in Model.EntryMasters)
                                    {
                                        <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                                    }
                                </select>
                                <span asp-validation-for="EntryMasterId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="LedgerAccountId" class="form-label">@L["Account"]</label>
                                <select asp-for="LedgerAccountId" class="form-select">
                                    <option value="">@L["Choose"]</option>
                                    @foreach (var item in Model.LedgerAccounts)
                                    {
                                        <option value="@item.Id">@(isArabicCulture ? item.ArName : item.EnName)</option>
                                    }
                                </select>
                                <span asp-validation-for="LedgerAccountId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DebitAmount" class="form-label">@L["DebitAmount"]</label>
                                <input asp-for="DebitAmount" class="form-control" />
                                <span asp-validation-for="DebitAmount" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CreditAmount" class="form-label">@L["CreditAmount"]</label>
                                <input asp-for="CreditAmount" class="form-control" />
                                <span asp-validation-for="CreditAmount" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                <div class="card-footer d-flex justify-content-center gap-2 bg-transparent">
                    <button type="submit" class="btn btn-primary px-5">@L["Save"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-5">@L["Cancel"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
