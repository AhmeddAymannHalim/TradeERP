@model UpdateUserViewModel
@{
    ViewBag.Title = L["EditUser"];
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-xl-6">
            <form asp-action="Update">
                <input type="hidden" asp-for="Id" />
                <div class="card shadow-sm">
                    <div class="card-header text-center">
                        <h4 class="fw-bold m-0">@L["EditUser"]</h4>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label">@L["Email"]</label>
                                <input class="form-control" value="@Model.Email" disabled />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label d-block">@L["Roles"]</label>
                                <div class="d-flex gap-4">
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" name="SelectedRoles" value="@role" id="role_@role"
                                                   checked="@(Model.SelectedRoles.Contains(role))" />
                                            <label class="form-check-label" for="role_@role">@role</label>
                                        </div>
                                    }
                                </div>
                                <span data-valmsg-for="SelectedRoles" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-primary px-5">@L["Save"]</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-5">@L["Cancel"]</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
