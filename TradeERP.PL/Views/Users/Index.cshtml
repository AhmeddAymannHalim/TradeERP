@model PaginatedResult<UserListItemViewModel>
@{
    ViewBag.Title = L["UserList"];
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="fw-bold">@L["UserList"]</h4>
        </div>
        <div class="card-body">
            <form id="antiforgeryTokenForm">@Html.AntiForgeryToken()</form>

            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> @L["New"]
                </a>
                <form asp-action="Index" method="get" class="d-flex align-items-center gap-1">
                    <input type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L["Email"]</th>
                            <th>@L["Roles"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data.Any())
                        {
                            var counter = (Model.PageNo - 1) * Model.PageSize + 1;
                            foreach (var item in Model.Data)
                            {
                                <tr>
                                    <td>@counter</td>
                                    <td>@item.Email</td>
                                    <td>
                                        @foreach (var role in item.Roles)
                                        {
                                            <span class="badge bg-primary-subtle text-primary-emphasis">@role</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsLockedOut)
                                        {
                                            <span class="badge bg-danger-subtle text-danger-emphasis">@L["Locked"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis">@L["Active"]</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="javascript:void(0)" onclick="ToggleLock('@item.Id')" class="btn btn-warning btn-sm">
                                            <i class="bi @(item.IsLockedOut ? "bi-unlock" : "bi-lock")"></i>
                                        </a>
                                        <a href="javascript:void(0)" onclick="UserDelete('@item.Id')" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                counter++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">@L["NoData"]</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @await Html.PartialAsync("_Pagination", Model)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function usersAntiForgeryToken() {
            return document.querySelector('#antiforgeryTokenForm input[name="__RequestVerificationToken"]').value;
        }

        function postUserAction(url) {
            const body = new URLSearchParams();
            body.set('__RequestVerificationToken', usersAntiForgeryToken());
            return fetch(url, { method: 'POST', body })
                .then(r => r.json());
        }

        function ToggleLock(id) {
            TradeERP.confirmAction(t('ActionCannotBeUndone'), t('AreYouSure')).then(confirmed => {
                if (!confirmed) return;

                postUserAction('/Users/ToggleLock/' + id).then(result => {
                    if (result.success) {
                        TradeERP.showToast(t('UpdatedSuccessfully'), 'success');
                        setTimeout(() => location.reload(), 800);
                    } else {
                        TradeERP.showToast(result.message || result.errorMessage || t('SomethingWentError'), 'error');
                    }
                });
            });
        }

        function UserDelete(id) {
            TradeERP.confirmAction(t('ActionCannotBeUndone'), t('AreYouSure')).then(confirmed => {
                if (!confirmed) return;

                postUserAction('/Users/Delete/' + id).then(result => {
                    if (result.success) {
                        TradeERP.showToast(result.message || t('DeletedSuccessfully'), 'success');
                        setTimeout(() => location.reload(), 800);
                    } else {
                        TradeERP.showToast(result.message || result.errorMessage || t('DeleteFailed'), 'error');
                    }
                });
            });
        }
    </script>
}
