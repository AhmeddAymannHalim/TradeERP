@{
    string CurrentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string CurrentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string IsActive(string controller, string? action = null)
    {
        if (!string.Equals(CurrentController, controller, StringComparison.OrdinalIgnoreCase))
            return "";

        if (action != null && !string.Equals(CurrentAction, action, StringComparison.OrdinalIgnoreCase))
            return "";

        return "active";
    }

    bool InGroup(params string[] controllers) =>
        controllers.Any(c => string.Equals(CurrentController, c, StringComparison.OrdinalIgnoreCase));

    var masterDataControllers = new[] { "Employee", "Customer", "Supplier", "Specialization", "Department", "Category", "Product", "LedgerAccount" };
    var inventoryControllers = new[] { "StockLedger" };
    var salesPurchasingControllers = new[] { "BillMaster" };
    var accountingControllers = new[] { "EntryMaster", "VoucherMaster", "OpeningBalance", "BillSetting", "EntrySetting", "BillDetails", "EntryDetails" };
    var advancedControllers = new[] { "BillSetting", "EntrySetting", "BillDetails", "EntryDetails" };

    bool isReportsAction(params string[] actions) =>
        string.Equals(CurrentController, "Reports", StringComparison.OrdinalIgnoreCase) && actions.Contains(CurrentAction, StringComparer.OrdinalIgnoreCase);

    bool masterDataOpen = InGroup(masterDataControllers);
    bool inventoryOpen = InGroup(inventoryControllers) || isReportsAction("StockValuation");
    bool salesPurchasingOpen = InGroup(salesPurchasingControllers) || isReportsAction("BillSales", "BillSalesReturn", "BillPurchases", "BillReturnPurchases");
    bool accountingOpen = InGroup(accountingControllers) || isReportsAction("TrialBalance", "StatementOfAccount");
    bool advancedOpen = InGroup(advancedControllers);
}
<aside id="sidebar" class="sidebar">
    <div class="logo-area">
        <a asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center text-decoration-none">
            <i class="ti ti-building-store fs-4 text-primary"></i>
            <span class="logo-text ms-2 fw-bold text-dark">TradeERP</span>
        </a>
    </div>

    <div class="sidebar-nav-scroll">
    <ul class="nav flex-column">
        <li class="px-4 py-2"><small class="nav-text">@L["Main"]</small></li>
        <li>
            <a class="nav-link @IsActive("Home")" asp-controller="Home" asp-action="Index">
                <i class="ti ti-layout-dashboard"></i><span class="nav-text">@L["Dashboard"]</span>
            </a>
        </li>

        @if (User.IsInRole("Admin"))
        {
            <li class="px-4 pt-4 pb-2"><small class="nav-text">@L["Administration"]</small></li>
            <li>
                <a class="nav-link @IsActive("Users", "Index")" asp-controller="Users" asp-action="Index">
                    <i class="ti ti-user-cog"></i><span class="nav-text">@L["Users"]</span>
                </a>
            </li>
            <li>
                <a class="nav-link @IsActive("AccountingPeriod", "Index")" asp-controller="AccountingPeriod" asp-action="Index">
                    <i class="ti ti-calendar-check"></i><span class="nav-text">@L["AccountingPeriodList"]</span>
                </a>
            </li>
        }

        <li class="px-4 pt-4 pb-2"><small class="nav-text">@L["Modules"]</small></li>

        <li>
            <a class="nav-link @(masterDataOpen ? "" : "collapsed")" href="javascript:void(0)" data-bs-toggle="collapse" data-bs-target="#masterDataMenu" aria-expanded="@(masterDataOpen ? "true" : "false")">
                <i class="ti ti-list-details"></i><span class="nav-text">@L["Definitions"]</span>
                <i class="ti ti-chevron-down nav-chevron"></i>
            </a>
            <ul class="nav flex-column collapse @(masterDataOpen ? "show" : "")" id="masterDataMenu">
                <li><a class="nav-link @IsActive("Employee", "Index")" asp-controller="Employee" asp-action="Index">@L["Employees"]</a></li>
                <li><a class="nav-link @IsActive("Customer", "Index")" asp-controller="Customer" asp-action="Index">@L["CustomerList"]</a></li>
                <li><a class="nav-link @IsActive("Supplier", "Index")" asp-controller="Supplier" asp-action="Index">@L["SupplierList"]</a></li>
                <li><a class="nav-link @IsActive("Specialization", "Index")" asp-controller="Specialization" asp-action="Index">@L["Specializations"]</a></li>
                <li><a class="nav-link @IsActive("Department", "Index")" asp-controller="Department" asp-action="Index">@L["Departments"]</a></li>
                <li><a class="nav-link @IsActive("Category", "Index")" asp-controller="Category" asp-action="Index">@L["CategoryList"]</a></li>
                <li><a class="nav-link @IsActive("Product", "Index")" asp-controller="Product" asp-action="Index">@L["ProductList"]</a></li>
                <li><a class="nav-link @IsActive("LedgerAccount", "Index")" asp-controller="LedgerAccount" asp-action="Index">@L["LedgerAccountList"]</a></li>
            </ul>
        </li>

        <li>
            <a class="nav-link @(inventoryOpen ? "" : "collapsed")" href="javascript:void(0)" data-bs-toggle="collapse" data-bs-target="#inventoryMenu" aria-expanded="@(inventoryOpen ? "true" : "false")">
                <i class="ti ti-box-seam"></i><span class="nav-text">@L["Inventory"]</span>
                <i class="ti ti-chevron-down nav-chevron"></i>
            </a>
            <ul class="nav flex-column collapse @(inventoryOpen ? "show" : "")" id="inventoryMenu">
                <li><a class="nav-link @IsActive("StockLedger", "Index")" asp-controller="StockLedger" asp-action="Index">@L["StockLedgerList"]</a></li>
                <li><a class="nav-link @(isReportsAction("StockValuation") ? "active" : "")" asp-controller="Reports" asp-action="StockValuation">@L["StockValuation"]</a></li>
            </ul>
        </li>

        <li>
            <a class="nav-link @(salesPurchasingOpen ? "" : "collapsed")" href="javascript:void(0)" data-bs-toggle="collapse" data-bs-target="#salesPurchasingMenu" aria-expanded="@(salesPurchasingOpen ? "true" : "false")">
                <i class="ti ti-shopping-cart-check"></i><span class="nav-text">@L["SalesAndPurchasing"]</span>
                <i class="ti ti-chevron-down nav-chevron"></i>
            </a>
            <ul class="nav flex-column collapse @(salesPurchasingOpen ? "show" : "")" id="salesPurchasingMenu">
                <li><a class="nav-link @IsActive("BillMaster", "Index")" asp-controller="BillMaster" asp-action="Index">@L["BillMasterList"]</a></li>
                <li><a class="nav-link @(isReportsAction("BillSales") ? "active" : "")" asp-controller="Reports" asp-action="BillSales">@L["BillSales"]</a></li>
                <li><a class="nav-link @(isReportsAction("BillSalesReturn") ? "active" : "")" asp-controller="Reports" asp-action="BillSalesReturn">@L["BillSalesReturn"]</a></li>
                <li><a class="nav-link @(isReportsAction("BillPurchases") ? "active" : "")" asp-controller="Reports" asp-action="BillPurchases">@L["BillPurchases"]</a></li>
                <li><a class="nav-link @(isReportsAction("BillReturnPurchases") ? "active" : "")" asp-controller="Reports" asp-action="BillReturnPurchases">@L["BillReturnPurchases"]</a></li>
            </ul>
        </li>

        <li>
            <a class="nav-link @(accountingOpen ? "" : "collapsed")" href="javascript:void(0)" data-bs-toggle="collapse" data-bs-target="#accountingMenu" aria-expanded="@(accountingOpen ? "true" : "false")">
                <i class="ti ti-calculator"></i><span class="nav-text">@L["Accounting"]</span>
                <i class="ti ti-chevron-down nav-chevron"></i>
            </a>
            <ul class="nav flex-column collapse @(accountingOpen ? "show" : "")" id="accountingMenu">
                <li><a class="nav-link @IsActive("EntryMaster", "Index")" asp-controller="EntryMaster" asp-action="Index">@L["EntryMasterList"]</a></li>
                <li><a class="nav-link @IsActive("VoucherMaster", "Index")" asp-controller="VoucherMaster" asp-action="Index">@L["VoucherMasterList"]</a></li>
                <li><a class="nav-link @IsActive("OpeningBalance", "Create")" asp-controller="OpeningBalance" asp-action="Create">@L["InsertNewOpeningBalance"]</a></li>
                <li><a class="nav-link @(isReportsAction("TrialBalance") ? "active" : "")" asp-controller="Reports" asp-action="TrialBalance">@L["TrialBalance"]</a></li>
                <li><a class="nav-link @(isReportsAction("StatementOfAccount") ? "active" : "")" asp-controller="Reports" asp-action="StatementOfAccount">@L["StatementOfAccount"]</a></li>

                <li>
                    <a class="nav-link @(advancedOpen ? "" : "collapsed")" href="javascript:void(0)" data-bs-toggle="collapse" data-bs-target="#advancedMenu" aria-expanded="@(advancedOpen ? "true" : "false")">
                        <span class="nav-text">@L["Advanced"]</span>
                        <i class="ti ti-chevron-down nav-chevron"></i>
                    </a>
                    <ul class="nav flex-column collapse @(advancedOpen ? "show" : "")" id="advancedMenu">
                        <li><a class="nav-link @IsActive("BillSetting", "Index")" asp-controller="BillSetting" asp-action="Index">@L["BillSettingList"]</a></li>
                        <li><a class="nav-link @IsActive("EntrySetting", "Index")" asp-controller="EntrySetting" asp-action="Index">@L["EntrySettingList"]</a></li>
                        <li><a class="nav-link @IsActive("BillDetails", "Index")" asp-controller="BillDetails" asp-action="Index">@L["BillDetailsList"]</a></li>
                        <li><a class="nav-link @IsActive("EntryDetails", "Index")" asp-controller="EntryDetails" asp-action="Index">@L["EntryDetailsList"]</a></li>
                    </ul>
                </li>
            </ul>
        </li>

        <li class="px-4 pt-4 pb-2"><small class="nav-text">@L["Upcoming"]</small></li>
        <li>
            <a class="nav-link disabled" href="javascript:void(0)" aria-disabled="true" tabindex="-1">
                <i class="ti ti-users-group"></i><span class="nav-text">@L["HR"]</span>
            </a>
        </li>
    </ul>
    </div>
</aside>
