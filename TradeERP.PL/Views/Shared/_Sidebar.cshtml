<div class="left-side-menu">
    <a class="logo-box" asp-controller="Home" asp-action="Index">
        <i class="bi bi-boxes"></i>
        <span>TradeERP</span>
    </a>

    <div id="sidebar-menu">
        <ul id="side-menu">
            <li>
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 text-primary"></i>
                    <span>@L["Dashboard"]</span>
                </a>
            </li>

            @if (User.IsInRole("Admin"))
            {
                <li class="side-nav-title">@L["Administration"]</li>
                <li>
                    <a asp-controller="Users" asp-action="Index">
                        <i class="bi bi-person-gear text-primary"></i>
                        <span>@L["Users"]</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AccountingPeriod" asp-action="Index">
                        <i class="bi bi-calendar-check text-primary"></i>
                        <span>@L["AccountingPeriodList"]</span>
                    </a>
                </li>
            }

            <li class="side-nav-title">@L["Modules"]</li>

            <li>
                <a href="#definitionsMenu" data-bs-toggle="collapse" aria-expanded="true">
                    <i class="bi bi-card-list text-warning"></i>
                    <span>@L["Definitions"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse show" id="definitionsMenu">
                    <ul class="nav-second-level">
                        <li><a asp-controller="Employee" asp-action="Index">@L["Employees"]</a></li>
                        <li><a asp-controller="Specialization" asp-action="Index">@L["Specializations"]</a></li>
                        <li><a asp-controller="Department" asp-action="Index">@L["Departments"]</a></li>
                    </ul>
                </div>
            </li>

            <li>
                <a href="#reportsMenu" data-bs-toggle="collapse" aria-expanded="true">
                    <i class="bi bi-bar-chart-line text-info"></i>
                    <span>@L["Reports"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse show" id="reportsMenu">
                    <ul class="nav-second-level">
                        <li><a asp-controller="Reports" asp-action="TrialBalance">@L["TrialBalance"]</a></li>
                        <li><a asp-controller="Reports" asp-action="StatementOfAccount">@L["StatementOfAccount"]</a></li>
                        <li><a asp-controller="Reports" asp-action="StockValuation">@L["StockValuation"]</a></li>
                    </ul>
                </div>
            </li>

            <li>
                <a href="#inventoryMenu" data-bs-toggle="collapse">
                    <i class="bi bi-box-seam text-success"></i>
                    <span>@L["Inventory"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse" id="inventoryMenu">
                    <ul class="nav-second-level">
                        <li><a asp-controller="Category" asp-action="Index">@L["CategoryList"]</a></li>
                        <li><a asp-controller="Product" asp-action="Index">@L["ProductList"]</a></li>
                        <li><a asp-controller="StockLedger" asp-action="Index">@L["StockLedgerList"]</a></li>
                    </ul>
                </div>
            </li>

            <li>
                <a href="#salesMenu" data-bs-toggle="collapse">
                    <i class="bi bi-cart-check text-danger"></i>
                    <span>@L["Sales"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse" id="salesMenu">
                    <ul class="nav-second-level">
                        <li><a asp-controller="Customer" asp-action="Index">@L["CustomerList"]</a></li>
                    </ul>
                </div>
            </li>

            <li>
                <a href="#purchasingMenu" data-bs-toggle="collapse">
                    <i class="bi bi-truck text-warning"></i>
                    <span>@L["Purchasing"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse" id="purchasingMenu">
                    <ul class="nav-second-level">
                        <li><a asp-controller="Supplier" asp-action="Index">@L["SupplierList"]</a></li>
                    </ul>
                </div>
            </li>

            <li>
                <a href="#accountingMenu" data-bs-toggle="collapse">
                    <i class="bi bi-calculator text-dark"></i>
                    <span>@L["Accounting"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse" id="accountingMenu">
                    <ul class="nav-second-level">
                        <li><a asp-controller="LedgerAccount" asp-action="Index">@L["LedgerAccountList"]</a></li>
                        <li><a asp-controller="BillMaster" asp-action="Index">@L["BillMasterList"]</a></li>
                        <li><a asp-controller="BillDetails" asp-action="Index">@L["BillDetailsList"]</a></li>
                        <li><a asp-controller="EntryMaster" asp-action="Index">@L["EntryMasterList"]</a></li>
                        <li><a asp-controller="EntryDetails" asp-action="Index">@L["EntryDetailsList"]</a></li>
                        <li><a asp-controller="BillSetting" asp-action="Index">@L["BillSettingList"]</a></li>
                        <li><a asp-controller="EntrySetting" asp-action="Index">@L["EntrySettingList"]</a></li>
                        <li><a asp-controller="VoucherMaster" asp-action="Index">@L["VoucherMasterList"]</a></li>
                        <li><a asp-controller="OpeningBalance" asp-action="Create">@L["InsertNewOpeningBalance"]</a></li>
                    </ul>
                </div>
            </li>

            <li class="side-nav-title">@L["Upcoming"]</li>

            <li>
                <a href="#hrMenu" data-bs-toggle="collapse">
                    <i class="bi bi-people text-secondary"></i>
                    <span>@L["HR"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse" id="hrMenu">
                    <ul class="nav-second-level">
                        <li><a class="disabled" href="#">@L["Payroll"]</a></li>
                    </ul>
                </div>
            </li>
        </ul>
    </div>
</div>
