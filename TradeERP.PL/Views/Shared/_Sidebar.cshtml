<div class="left-side-menu">
    <a class="logo-box" asp-controller="Home" asp-action="Index">
        <i class="bi bi-boxes"></i>
        <span>TradeERP</span>
    </a>

    <div id="sidebar-menu">
        <ul id="side-menu">
            <li>
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 text-primary"></i>
                    <span>@L["Dashboard"]</span>
                </a>
            </li>

            @if (User.IsInRole("Admin"))
            {
                <li class="side-nav-title">@L["Administration"]</li>
                <li>
                    <a asp-controller="Users" asp-action="Index">
                        <i class="bi bi-person-gear text-primary"></i>
                        <span>@L["Users"]</span>
                    </a>
                </li>
            }

            <li class="side-nav-title">@L["Modules"]</li>

            <li>
                <a href="#definitionsMenu" data-bs-toggle="collapse" aria-expanded="true">
                    <i class="bi bi-card-list text-warning"></i>
                    <span>@L["Definitions"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse show" id="definitionsMenu">
                    <ul class="nav-second-level">
                        <li><a asp-controller="Employee" asp-action="Index">@L["Employees"]</a></li>
                        <li><a asp-controller="Specialization" asp-action="Index">@L["Specializations"]</a></li>
                        <li><a asp-controller="Department" asp-action="Index">@L["Departments"]</a></li>
                    </ul>
                </div>
            </li>

            <li>
                <a href="#reportsMenu" data-bs-toggle="collapse" aria-expanded="true">
                    <i class="bi bi-bar-chart-line text-info"></i>
                    <span>@L["Reports"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse show" id="reportsMenu">
                    <ul class="nav-second-level">
                        <li><a class="disabled" href="#">@L["Reports"] <span class="badge bg-secondary">@L["Soon"]</span></a></li>
                    </ul>
                </div>
            </li>

            <li class="side-nav-title">@L["Upcoming"]</li>

            <li>
                <a href="#inventoryMenu" data-bs-toggle="collapse">
                    <i class="bi bi-box-seam text-success"></i>
                    <span>@L["Inventory"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse" id="inventoryMenu">
                    <ul class="nav-second-level">
                        <li><a class="disabled" href="#">@L["Products"]</a></li>
                    </ul>
                </div>
            </li>

            <li>
                <a href="#salesMenu" data-bs-toggle="collapse">
                    <i class="bi bi-cart-check text-danger"></i>
                    <span>@L["Sales"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse" id="salesMenu">
                    <ul class="nav-second-level">
                        <li><a class="disabled" href="#">@L["Orders"]</a></li>
                    </ul>
                </div>
            </li>

            <li>
                <a href="#hrMenu" data-bs-toggle="collapse">
                    <i class="bi bi-people text-secondary"></i>
                    <span>@L["HR"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse" id="hrMenu">
                    <ul class="nav-second-level">
                        <li><a class="disabled" href="#">@L["Payroll"]</a></li>
                    </ul>
                </div>
            </li>

            <li>
                <a href="#accountingMenu" data-bs-toggle="collapse">
                    <i class="bi bi-calculator text-dark"></i>
                    <span>@L["Accounting"]</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse" id="accountingMenu">
                    <ul class="nav-second-level">
                        <li><a class="disabled" href="#">@L["Ledger"]</a></li>
                    </ul>
                </div>
            </li>
        </ul>
    </div>
</div>
