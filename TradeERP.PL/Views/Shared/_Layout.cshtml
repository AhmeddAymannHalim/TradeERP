<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TradeERP</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.2.5/dist/css/tabulator_bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex" id="app-wrapper">
        <!-- Sidebar -->
        <nav class="sidebar bg-dark text-white p-3" id="sidebar">
            <a class="d-flex align-items-center mb-4 text-white text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="fs-4 fw-bold">TradeERP</span>
            </a>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index" class="nav-link text-white">Dashboard</a>
                </li>
                <li class="nav-item mt-2 text-uppercase small text-white-50 px-2">Definitions</li>
                <li class="nav-item"><a class="nav-link text-white-50 disabled" href="#">Employees</a></li>
                <li class="nav-item"><a class="nav-link text-white-50 disabled" href="#">Departments</a></li>
                <li class="nav-item mt-2 text-uppercase small text-white-50 px-2">Inventory</li>
                <li class="nav-item"><a class="nav-link text-white-50 disabled" href="#">Products</a></li>
                <li class="nav-item mt-2 text-uppercase small text-white-50 px-2">Sales</li>
                <li class="nav-item"><a class="nav-link text-white-50 disabled" href="#">Orders</a></li>
                <li class="nav-item mt-2 text-uppercase small text-white-50 px-2">HR</li>
                <li class="nav-item"><a class="nav-link text-white-50 disabled" href="#">Payroll</a></li>
                <li class="nav-item mt-2 text-uppercase small text-white-50 px-2">Accounting</li>
                <li class="nav-item"><a class="nav-link text-white-50 disabled" href="#">Ledger</a></li>
                <li class="nav-item mt-2 text-uppercase small text-white-50 px-2">Reports</li>
                <li class="nav-item"><a class="nav-link text-white-50 disabled" href="#">Reports</a></li>
            </ul>
        </nav>

        <!-- Main content -->
        <div class="flex-grow-1 d-flex flex-column" id="main-content">
            <header class="navbar navbar-expand navbar-light bg-white border-bottom px-3">
                <button class="btn btn-outline-secondary d-md-none" id="sidebarToggle" type="button">
                    <span>&#9776;</span>
                </button>
                <span class="navbar-text ms-auto">@ViewData["Title"]</span>
            </header>

            <main role="main" class="p-3 flex-grow-1">
                @RenderBody()
            </main>

            <footer class="border-top text-muted p-3 small">
                &copy; 2026 - TradeERP
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://unpkg.com/tabulator-tables@6.2.5/dist/js/tabulator.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('show');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
