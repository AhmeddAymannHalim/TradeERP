@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var dir = isArabic ? "rtl" : "ltr";
    var lang = isArabic ? "ar" : "en";
    var bootstrapCss = isArabic
        ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
        : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css";
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TradeERP</title>

    <link href="@bootstrapCss" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.2.5/dist/css/tabulator_bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@19.5.6/build/css/intlTelInput.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="wrapper">
        <partial name="_Navbar" />
        <partial name="_Sidebar" />

        <div class="content-page">
            <div class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>

            <footer class="footer">
                <div class="container-fluid text-center">
                    &copy; 2026 TradeERP - All Rights Reserved
                </div>
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://unpkg.com/tabulator-tables@6.2.5/dist/js/tabulator.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@19.5.6/build/js/intlTelInput.min.js"></script>

    <script>
        window.CurrentCulture = "@lang";
        window.L = {
            SavedSuccessfully: "@L["SavedSuccessfully"]",
            UpdatedSuccessfully: "@L["UpdatedSuccessfully"]",
            ErrorWhileSaving: "@L["ErrorWhileSaving"]",
            ErrorWhileUpdating: "@L["ErrorWhileUpdating"]",
            ValidationError: "@L["ValidationError"]",
            RecordNotFound: "@L["RecordNotFound"]",
            SomethingWentError: "@L["SomethingWentError"]",
            DeletedSuccessfully: "@L["DeletedSuccessfully"]",
            DeleteFailed: "@L["DeleteFailed"]",
            AreYouSure: "@L["AreYouSure"]",
            ActionCannotBeUndone: "@L["ActionCannotBeUndone"]",
            Yes: "@L["Yes"]",
            Cancel: "@L["Cancel"]",
            InvalidPhoneNumber: "@L["InvalidPhoneNumber"]"
        };
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @{
        var toastrJson = TempData[TradeERP.Shared.Constants.ToastrDefaults.ToasterList] as string;
    }
    @if (!string.IsNullOrEmpty(toastrJson))
    {
        <script>
            (function () {
                var toasts = @Html.Raw(toastrJson);
                var icons = ['success', 'info', 'warning', 'error'];
                toasts.forEach(function (t) {
                    showToast(t.Message, icons[t.Type] || 'info');
                });
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
