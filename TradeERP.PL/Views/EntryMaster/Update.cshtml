@model EntryMasterViewModel
@{
    ViewBag.Title = L["EditEntryMaster"];
    bool isSystemGenerated = Model.EntryType != TradeERP.Shared.Enums.EntryType.Manual;
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <form asp-action="Update">
            <input type="hidden" asp-for="Id" />
            <div class="card">
                <div class="card-header bg-transparent px-4 py-3">
                    <h4 class="mb-0 h5">@L["EditEntryMaster"]</h4>
                </div>
                <div class="card-body p-4">
                        @if (isSystemGenerated)
                        {
                            <div class="alert alert-warning">@L["EntryIsSystemGenerated"]</div>
                        }
                        <fieldset disabled="@isSystemGenerated">
                            <div class="row g-3 align-items-center justify-content-center">
                                <div class="col-md-4">
                                    <label asp-for="Code" class="form-label"></label>
                                    <input asp-for="Code" class="form-control" />
                                    <span asp-validation-for="Code" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="EntryDate" class="form-label">@L["EntryDate"]</label>
                                    <input asp-for="EntryDate" type="date" class="form-control" />
                                    <span asp-validation-for="EntryDate" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label d-block">@L["EntryType"]</label>
                                    <span class="badge bg-secondary">@L[Model.EntryType.ToString()]</span>
                                </div>
                                <div class="col-md-8">
                                    <label asp-for="Description" class="form-label">@L["Description"]</label>
                                    <input asp-for="Description" class="form-control" />
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                        </fieldset>
                </div>
                <div class="card-footer d-flex justify-content-center gap-2 bg-transparent">
                    @if (!isSystemGenerated)
                    {
                        <button type="submit" class="btn btn-primary px-5">@L["Save"]</button>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary px-5">@L["Cancel"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
