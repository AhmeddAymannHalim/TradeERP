@model PaginatedResult<EntryMasterViewModel>
@{
    ViewBag.Title = L["EntryMasterList"];
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="fw-bold">@L["EntryMasterList"]</h4>
        </div>
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> @L["New"]
                </a>
                <form asp-action="Index" method="get" class="d-flex align-items-center gap-1">
                    <input type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L["Code"]</th>
                            <th>@L["EntryDate"]</th>
                            <th>@L["Description"]</th>
                            <th>@L["EntryType"]</th>
                            <th>@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data.Any())
                        {
                            var counter = (Model.PageNo - 1) * Model.PageSize + 1;
                            foreach (var item in Model.Data)
                            {
                                <tr>
                                    <td>@counter</td>
                                    <td>@item.Code</td>
                                    <td>@item.EntryDate.ToShortDateString()</td>
                                    <td>@item.Description</td>
                                    <td>@L[item.EntryType.ToString()]</td>
                                    <td>
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (item.EntryType == TradeERP.Shared.Enums.EntryType.Manual)
                                        {
                                            <a href="javascript:void(0)" onclick="Delete('/EntryMaster/Delete/@item.Id')" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                                counter++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">@L["NoData"]</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @await Html.PartialAsync("_Pagination", Model)
            </div>
        </div>
    </div>
</div>
